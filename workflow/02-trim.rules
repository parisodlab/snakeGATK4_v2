import os

import pandas as pd

configfile: "config_main.yaml"

samples = pd.read_csv(config["METAFILE"], sep="\t")

if "sample_lane" not in samples.columns:
    if {"sample", "lane", "sample_barcode"}.issubset(samples.columns):
        samples["sample_lane"] = (
            samples["sample"].astype(str)
            + "_"
            + samples["lane"].astype(str)
            + "_"
            + samples["sample_barcode"].astype(str)
        )
    elif {"sample", "lane"}.issubset(samples.columns):
        samples["sample_lane"] = samples["sample"].astype(str) + "_" + samples["lane"].astype(str)
    elif "prefix" in samples.columns:
        samples["sample_lane"] = samples["prefix"].astype(str)
    else:
        raise ValueError(
            "METAFILE must contain 'sample_lane' or ('sample' and 'lane' [and optionally 'sample_barcode']) or 'prefix'"
        )

samples["prefix"] = samples["sample_lane"].astype(str)
samples = samples.set_index(["prefix"], drop=False)

final_path = config["FINALOUTPUT"] + "/" + config["PROJECT"]

wildcard_constraints:
    prefix = "[^/]+",
    sample = "[^/]+"

sample = samples["sample"].astype(str).unique().tolist()
prefix = samples["prefix"].astype(str).tolist()

# Define a function to get the fastq files for a given prefix
def get_fastq(wildcards):
    fastqs = samples.loc[(wildcards.prefix), ["fq1", "fq2"]].dropna()
    return {"r1": fastqs.fq1, "r2": fastqs.fq2}

def get_trimmed_fastq(wildcards):
    fastqs = samples.loc[(wildcards.prefix), ["fq1", "fq2"]].dropna()
    return {"r1": os.path.join("data/trimmed",wildcards.prefix + "_R1_001.trim.fastq.gz"), "r2": os.path.join("data/trimmed",wildcards.prefix + "_R2_001.trim.fastq.gz")}


rule end:
    input:
        r1 = expand(final_path + "/data/trimmed/{prefix}_R1_001.trim.fastq.gz", prefix=prefix),
        r2 = expand(final_path + "/data/trimmed/{prefix}_R2_001.trim.fastq.gz", prefix=prefix),
        report_html = expand(final_path + "/fastp/{prefix}.html", prefix=prefix),
        report_json = expand(final_path + "/fastp/{prefix}.json", prefix=prefix)



rule trim:
    input:
        unpack(get_fastq)
    output:
        r1 = final_path + "/data/trimmed/{prefix}_R1_001.trim.fastq.gz",
        r2 = final_path + "/data/trimmed/{prefix}_R2_001.trim.fastq.gz",
        report_html = final_path + "/fastp/{prefix}.html",
        report_json = final_path + "/fastp/{prefix}.json"
    benchmark:
        "benchmarks/fastp/fastp_{prefix}.txt"
    params:
        compression_level="-9",
        minlen=25,  # Equivalent to MINLEN:25 in Trimmomatic
        sliding_window="4:15"  # Equivalent to SLIDINGWINDOW:4:15
    threads: 8
    shell:
        """
        fastp -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              --trim_poly_g \
              --detect_adapter_for_pe \
              --cut_front --cut_tail \
              --cut_window_size 4 \
              --cut_mean_quality 15 \
              --qualified_quality_phred 15 \
              --length_required {params.minlen} \
              --thread 8 \
              --html {output.report_html} --json {output.report_json} 

        """



