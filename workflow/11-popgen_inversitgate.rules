# Snakemake rules for population-genetics follow-up analyses
# - prepares mapping files from metadata and an (unrooted) Newick tree
# - runs Dsuite (Dtrios -> Fbranch -> Dinvestigate), TreeMix, windowed PCA and TWISST
#
# Usage notes:
# - Provide keys in your Snakemake `config.yaml` under `popgen_investigate`:
#     metadata: path/to/metadata.tsv     # must contain sampleID and population columns
#     vcf:      path/to/input.vcf.gz      # bcf/vcf with sample IDs matching metadata
#     tree:     path/to/unrooted.tree     # unrooted Newick tree (tip names must match sampleIDs)
#     outdir:   results/popgen_investigate
#     threads:  4                         # default threads
# - The rules call external tools (Dsuite, TreeMix, iqtree/raxml/fasttree, python scripts). Adjust commands
#   to the locations on your system (or use conda/singularity wrappers in the `shell` directives).
import pandas as pd
import os
import sys
import itertools

configfile: "config_main.yaml"

cfg = config.get('popgen_investigate', {})
METAFILE = config.get('METAFILE')
TREE     = cfg.get('tree', 'tree_unrooted.nwk')
final_path = os.path.join(config["FINALOUTPUT"], config["PROJECT"])
OUTDIR   = os.path.join(final_path, "popgen_investigate")
OUTGROUPS = cfg.get('outgroups', []) or []
VARIANT_CALLER = str(config.get("variant_caller", "gatk")).strip().lower()


def _caller_default_vcf():
    if VARIANT_CALLER == "freebayes":
        return os.path.join(final_path, "freebayes", "final_vcf", "filtered.vcf.gz")
    return os.path.join(final_path, "gatk4", "final_vcf", "filtered.vcf.gz")

# Prefer an explicitly provided VCF; otherwise fall back to the pipeline's filtered VCF.
DEFAULT_VCF = _caller_default_vcf()
VCF = cfg.get('vcf') or config.get('final_vcf') or DEFAULT_VCF

METADATA_DIR = os.path.join(final_path, "metadata")
METADATA = os.path.join(METADATA_DIR, "sample2pop.tsv")


rule write_sample2pop:
    """Write a simple sample<tab>pop mapping with a header.

    This file is used by multiple downstream tools (Dsuite, etc.).
    """
    input:
        metafile=METAFILE
    output:
        tsv=METADATA
    run:
        import pandas as pd
        import os

        if not input.metafile:
            raise ValueError("config['METAFILE'] must be set")
        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        if 'sample' not in df.columns:
            raise ValueError("METAFILE missing 'sample' column")
        pop_col = 'pop' if 'pop' in df.columns else ('population' if 'population' in df.columns else None)
        if pop_col is None:
            raise ValueError("METAFILE missing 'pop' or 'population' column")

        out = df[['sample', pop_col]].dropna().drop_duplicates(subset=['sample'])
        out.columns = ['sample', 'pop']
        if out['sample'].duplicated().any():
            raise ValueError('duplicate sample IDs found in METAFILE after deduplication')
        os.makedirs(os.path.dirname(output.tsv), exist_ok=True)
        out.to_csv(output.tsv, sep='\t', index=False, header=True)

rule all:
    input:
        # summary targets: adjust as you add/enable analyses
        f"{OUTDIR}/dsuite/analysis_Dmin.txt"
        # f"{OUTDIR}/dsuite/fbranch.txt",
        # f"{OUTDIR}/dinvestigate/dinvestigate_windows.txt",
        # f"{OUTDIR}/treemix/treemix_model.gz",
        # f"{OUTDIR}/twisst/twisst_weights.tsv",
        # f"{OUTDIR}/pca/windowed_pca_parquet"  # directory placeholder

# ---------------------------------------------------------------------------
# Basic preparation: extract sample->population mapping file used by many tools
# metadata must be a tab-separated table with header containing at least: sampleID, population
# Output format: two-column plain text: sampleID\tpopulation
rule prepare_dsuite_sets:
    input:
        metadata=rules.write_sample2pop.output.tsv
    output:
        groups = f"{OUTDIR}/metadata/sample2set.tsv"
    params:
        outgroups = ",".join(OUTGROUPS),
    shell:
        """
        awk -v OG="{params.outgroups}" '
        BEGIN{{
            FS=OFS="\t";
            n=split(OG,arr,",");
            for(i=1;i<=n;i++){{ g=arr[i]; pats[i]=g }}
        }}
        NR==1{{
            for(i=1;i<=NF;i++) h[$i]=i;
            sidx = (h["sample"]?h["sample"]:(h["sampleID"]?h["sampleID"]:0));
            pidx = (h["pop"]?h["pop"]:(h["population"]?h["population"]:(h["species"]?h["species"]:0)));
            if(!sidx||!pidx){{ print "ERROR: metadata missing sample/pop columns" > "/dev/stderr"; exit 1 }}
            next
        }}
        {{
            s=$sidx; p=$pidx; out=p;
            for(i=1;i<=n;i++){{ if(pats[i]!="" && s ~ ("^"pats[i])){{ out="Outgroup"; break }} }}
            print s, out
        }}' {input.metadata} > {output.groups}
        """

# Get unrooted tree, root it on samples that start with the letters in OUTGROUP 
rule root_tree:
    input:
        tree=TREE # unrooted tree
    output:
        tree=f"{OUTDIR}/dsuite/rooted_tree.nwk"  # rooted tree
    params:
        outgroups=",".join(OUTGROUPS)
    conda: "../env/make_nj_tree.yaml"
    shell:
        r"""
        # If no outgroups are provided, keep the tree as-is.
        if [ -z "{params.outgroups}" ]; then
            cp {input.tree} {output.tree}
            exit 0
        fi
        Rscript -e '
        library(ape);
        # Load tree
        tree <- read.tree("{input.tree}");
        # Parse outgroup letters from params
        letters <- unlist(strsplit("{params.outgroups}", ","));
        # Select outgroup tips
        outgroup <- grep(paste0("^(", paste(letters, collapse="|"), ")"), tree$tip.label, value = TRUE);
        print(paste("Outgroup samples for rooting:", paste(outgroup, collapse=", ")));
        # Root at outgroup
        rooted_tree <- root(tree, outgroup = outgroup, resolve.root = TRUE);
        # Write tree
        write.tree(rooted_tree, file="{output.tree}");
        '
        """

# ---------------------------------------------------------------------------
# Dsuite: Dtrios (run Dsuite to compute D-statistics across trios)
# requires: Dsuite in PATH. Adjust command if using conda/singularity.
rule dsuite_dtrios:
    input:
        vcf = VCF,
        groups = rules.prepare_dsuite_sets.output.groups,
        tree = rules.root_tree.output.tree
    output:
        dtrios = f"{OUTDIR}/dsuite/analysis_Dmin.txt",
        bbaa   = f"{OUTDIR}/dsuite/analysis_BBAA.txt"
    params:
        outdir = f"{OUTDIR}/dsuite",
        prefix = "analysis"
    threads: 4
    shell:
        """
        # Example: Dsuite Dtrios -c -o <prefix> <vcf> <groups>
        # -c : use genotype calls (if applicable). Remove or change flags for your VCF.
        mkdir -p {params.outdir}
        ../scripts/Dsuite/Build/Dsuite Dtrios -c -o {params.outdir}/{params.prefix} {input.vcf} {input.groups}
        """

