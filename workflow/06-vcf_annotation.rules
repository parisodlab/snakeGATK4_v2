import pandas as pd
import os
configfile: "config.yaml"


GENOME = config["GENOME"]
GENOME_GFF= config["GENOME_GFF"]
final_path=config["final_output"] 

rule all:
    input:
        final_path + "/degeneracy/degeneracy-fourfold.bed"

rule degeneracy_annotation:
    input:
        reference=GENOME,
        gff=GENOME_GFF,
    output:
        final_path + "/degeneracy/degeneracy-all-sites.bed"
    benchmark:
        "benchmarks/vcf_annotation/degeneracy.txt"
    threads:
        4
    params:
        outputpath=final_path + "/degeneracy/"
    resources:
        mem_mb = 8000,
        time = "3-0"
    conda: "../env/vcf_annotation.yaml"
    shell:
        """
        degenotate.py -a {input.gff} -g {input.reference} -o {params.outputpath} 
        """

rule degenerate_site_fourfold:
    input:
        bed=final_path + "/degeneracy/degeneracy-all-sites.bed"
    output:
        final_path + "/degeneracy/degeneracy-fourfold.bed"
    benchmark:
        "benchmarks/vcf_annotation/degeneracy_fourfold.bed"
    threads:
        4
    params:
        outputpath=final_path + "/degeneracy/"
    resources:
        mem_mb = 8000,
        time = "3-0"
    run:
        with open(input[0]) as f, open(output[0], "w") as out:
            for line in f:
                cols = line.strip().split("\t")
                # Keep the row only if column 5 equals '4'
                if len(cols) >= 5 and cols[4] == '4':
                    out.write(line)