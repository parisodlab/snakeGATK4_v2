import os

import pandas as pd

configfile: "config_main.yaml"

samples = pd.read_csv(config["METAFILE"], sep="\t")

if "sample_lane" not in samples.columns:
    if {"sample", "lane", "sample_barcode"}.issubset(samples.columns):
        samples["sample_lane"] = (
            samples["sample"].astype(str)
            + "_"
            + samples["lane"].astype(str)
            + "_"
            + samples["sample_barcode"].astype(str)
        )
    elif {"sample", "lane"}.issubset(samples.columns):
        samples["sample_lane"] = samples["sample"].astype(str) + "_" + samples["lane"].astype(str)
    elif "prefix" in samples.columns:
        samples["sample_lane"] = samples["prefix"].astype(str)
    else:
        raise ValueError(
            "METAFILE must contain 'sample_lane' or ('sample' and 'lane' [and optionally 'sample_barcode']) or 'prefix'"
        )

samples["prefix"] = samples["sample_lane"].astype(str)
samples = samples.set_index(["prefix"], drop=False)

final_path = config["FINALOUTPUT"] + "/" + config["PROJECT"]
TMPDIR = str(config.get("tmpdir", "tmp"))

sample = samples["sample"].astype(str).unique().tolist()
prefix = samples["prefix"].astype(str).tolist()

# Sequencing type affects whether duplicate marking/removal is appropriate.
# - wgs: run MarkDuplicates and use BAMs in /dedup downstream
# - ddrad: skip MarkDuplicates and use BAMs in /merged_samples downstream
SEQTYPE = str(config.get("SEQTYPE", "wgs")).strip().lower()
if SEQTYPE not in {"wgs", "ddrad"}:
    raise ValueError(f"Invalid SEQTYPE={SEQTYPE!r}. Expected 'wgs' or 'ddrad'.")
ANALYSIS_BAM_SUBDIR = "merged_samples" if SEQTYPE == "ddrad" else "dedup"
ANALYSIS_BAM_PATTERN = final_path + f"/{ANALYSIS_BAM_SUBDIR}/{{sample}}.bam"
ANALYSIS_BAI_PATTERN = final_path + f"/{ANALYSIS_BAM_SUBDIR}/{{sample}}.bam.bai"
MERGED_BAM_OUTPUT = final_path + "/merged_samples/{sample}.bam" if SEQTYPE == "ddrad" else temp(final_path + "/merged_samples/{sample}.bam")
MERGED_BAI_OUTPUT = final_path + "/merged_samples/{sample}.bam.bai" if SEQTYPE == "ddrad" else temp(final_path + "/merged_samples/{sample}.bam.bai")

wildcard_constraints:
    prefix = "[^/]+",
    sample = "[^/]+"

GENOME = config["GENOME"]
TRIMMING = config["TRIMMING"]

if TRIMMING == "yes":
    print("Working on trimmed fastq files")
else:
    print("Working on raw fastq files")

units = samples.reset_index(drop=True)[["sample", "prefix"]]
dunits = units.groupby("sample").agg(lambda x: x.tolist()).to_dict("index")


# Define a function to get the fastq files for a given prefix
def get_fastq(wildcards):
    fastqs = samples.loc[(wildcards.prefix), ["fq1", "fq2"]].dropna()
    return {"r1": fastqs.fq1, "r2": fastqs.fq2}

def get_trimmed_fastq(wildcards):
    fastqs = samples.loc[(wildcards.prefix), ["fq1", "fq2"]].dropna()
    return {"r1": os.path.join(final_path + "/data/trimmed",wildcards.prefix + "_R1_001.trim.fastq.gz"), "r2": os.path.join(final_path + "/data/trimmed",wildcards.prefix + "_R2_001.trim.fastq.gz")}



def get_read_group(wildcards):
    lane = samples.loc[(wildcards.prefix), "lane"] if "lane" in samples.columns else "NA"
    sampleid = samples.loc[(wildcards.prefix), "sample"]
    return {"lane":lane,"sampleid":sampleid}




rule end:
    input:
        report1 = final_path + "/bamcoverage/multiqc_report.html",
        report2 = expand(final_path + "/coverage/bamcov/{sample}_coverage.txt",sample=sample),
        bam = expand(ANALYSIS_BAM_PATTERN, sample=sample)



# if trimming is yes then use unpack(get_trimmed_fastq), else use unpack(get_fastq)
rule mapping:
    input:
        r1 = lambda wildcards: get_trimmed_fastq(wildcards)["r1"] if TRIMMING == "yes" else get_fastq(wildcards)["r1"],
        r2 = lambda wildcards: get_trimmed_fastq(wildcards)["r2"] if TRIMMING == "yes" else get_fastq(wildcards)["r2"],
        reference=GENOME
    output:
        bam=temp(final_path  + "/mapped/{prefix}.bam"),
        bai=temp(final_path  + "/mapped/{prefix}.bam.bai")
    benchmark:
        "benchmarks/mapping/mapping_{prefix}.txt"
    threads:
        20
    resources:
        time="1-0",
        sample=4
    params:
        lane=lambda wildcards : get_read_group(wildcards)['lane'],
        sampleid = lambda wildcards : get_read_group(wildcards)['sampleid'],
        platform = "illumina",
        tmpdir=TMPDIR
    shell:
       """ 
        set -e

        mkdir -p $(dirname {output.bam})
        mkdir -p {params.tmpdir}

        bwa mem -t {threads} -R '@RG\\tID:{wildcards.prefix}\\tSM:{params.sampleid}\\tPL:ILLUMINA\\tPU:{params.sampleid}:{wildcards.prefix}:{params.lane}' {input.reference} {input.r1} {input.r2} | \
        sambamba view --nthreads={threads} --show-progress --sam-input --format=bam --with-header /dev/stdin | \
        sambamba sort --nthreads={threads} --show-progress --tmpdir={params.tmpdir} --out={output.bam} /dev/stdin
        sambamba index --nthreads={threads} {output.bam}
	
        """


rule MergeBamLanes:
    input:
        bamin = lambda wildcards: expand( final_path + "/mapped/{unit}.bam",unit=dunits[wildcards.sample]["prefix"])
    output:
        out=MERGED_BAM_OUTPUT,
        bai=MERGED_BAI_OUTPUT,
    benchmark:
        "benchmarks/merged/{sample}.txt"
    resources:
        time="1-0",
        sample=4
    threads: 12
    params:
        inbam= lambda wildcards, input: " ".join(input.bamin),
        n_bams=lambda wildcards, input: len(input.bamin),
        single_bam=lambda wildcards, input: input.bamin[0]
    shell:
        """
        set -e
        if [ {params.n_bams} -eq 1 ]; then
            cp -f {params.single_bam} {output.out}
        else
            sambamba merge --nthreads={threads} --show-progress {output.out} {params.inbam}
        fi
        sambamba index --nthreads={threads} {output.out}
        """

rule MarkDuplicates:
    input:
        bam=final_path + "/merged_samples/{sample}.bam"
    output:
        bam=final_path + "/dedup/{sample}.bam",
        bai=final_path + "/dedup/{sample}.bam.bai",
        metrics=final_path + "/dedup/{sample}.duplicates.txt"
    benchmark:
        "benchmarks/dedup/{sample}.txt"
    threads: 12
    resources:
        time="1-0",
        mem_mb=20000,
        sample=4
    params:
        tmpdir=TMPDIR
    conda:
        "../env/markduplicates.yaml"
    shell:
        """
        set -e
        mkdir -p $(dirname {output.bam})
        mkdir -p {params.tmpdir}

        picard -Xmx8g -Xms1g -Djava.io.tmpdir={params.tmpdir} MarkDuplicates \
            I={input.bam} O={output.bam} \
            M={output.metrics} VALIDATION_STRINGENCY=SILENT \
            REMOVE_DUPLICATES=false TAGGING_POLICY=All REMOVE_SEQUENCING_DUPLICATES=TRUE \
            SORTING_COLLECTION_SIZE_RATIO=0.1 TMP_DIR={params.tmpdir} \
            OPTICAL_DUPLICATE_PIXEL_DISTANCE=2500

        sambamba index --nthreads={threads} {output.bam}
        """

rule CoverageReport:
    input:
        bam=ANALYSIS_BAM_PATTERN,
        bai=ANALYSIS_BAI_PATTERN
    output:
        summ=final_path + "/coverage/{sample}_summaryStats.txt",
        bamtools=final_path + "/coverage/{sample}_bamtools_stats.txt"
    benchmark:
        "benchmarks/coverage/{sample}.txt"
    threads: 12
    params:
        outputpath = final_path + "/coverage"
    shell:
        """
        sambamba depth base -t {threads} -c 0 -F "mapping_quality > 0 and not (duplicate or failed_quality_control or unmapped or secondary_alignment)" -o  {params.outputpath}/{wildcards.sample}.txt {input.bam}
        echo -n -e "Average read depth across genome:\t"  > {output.summ}
        cat {params.outputpath}/{wildcards.sample}.txt | awk '{{sum+=$3}} END {{print sum/NR}}' >> {output.summ}
        echo -n -e "% genome (breadth) covered >0x:\t" >> {output.summ}
        cat {params.outputpath}/{wildcards.sample}.txt | awk '{{c++; if($3>0) total+=1}}END{{print (total/c)*100}}' >> {output.summ}
        echo -n -e "% genome (breadth) covered >10x:\t" >> {output.summ}
        cat {params.outputpath}/{wildcards.sample}.txt | awk '{{c++; if($3>10) total+=1}}END{{print (total/c)*100}}' >> {output.summ}
        bamtools stats -in {input.bam} | grep -v "*" >  {params.outputpath}/{wildcards.sample}_bamtools_stats.txt
        rm {params.outputpath}/{wildcards.sample}.txt
        """

rule genomeCov:
    input:
        ANALYSIS_BAM_PATTERN
    output:
        final_path + "/coverage/bamcov/{sample}_coverage.txt"
    benchmark:
        "benchmarks/genomeCov/genomeCov_{sample}.txt"
    shell:
        """
        mkdir -p $(dirname {output})
        samtools coverage {input} > {output}
        """

rule deeptoolsCov:
    input:
        ANALYSIS_BAM_PATTERN
    output:
        final_path + "/bamcoverage/deeptools/{sample}_coverage.pdf"
    benchmark:
        "benchmarks/deeptoolsCov/deeptoolsCov_{sample}.txt"
    params:
        output = final_path + "/bamcoverage/deeptools/{sample}_coverage"
    conda:
        "../env/bamcoverage.yaml"
    threads: 12
    resources:
        mem_mb=100000
    shell:
        """
        plotCoverage  -b {input} --outRawCounts {params.output}.txt \
        --ignoreDuplicates --minMappingQuality 10 \
        -n 1000000000 -p {threads} -o {params.output}.pdf
        rm {params.output}.txt
        """

rule goleftCov:
    input:
        bams=expand(ANALYSIS_BAM_PATTERN, sample=sample),
        bais=expand(ANALYSIS_BAI_PATTERN, sample=sample)
    output:
        ped=final_path + "/bamcoverage/goleft/report/report-indexcov.ped",
        roc=final_path + "/bamcoverage/goleft/report/report-indexcov.roc",
        html=directory(final_path + "/bamcoverage/goleft/report"),
    log:
        "indexcov.log",
    shell:
        """
        mkdir -p {output.html}
        printf "sample\tsex\n" > {output.ped}
        for bam in {input.bams}; do
            sample_name=$(basename "$bam" .bam)
            printf "%s\tunknown\n" "$sample_name" >> {output.ped}
        done
        printf "sample\tstatus\n" > {output.roc}
        for bam in {input.bams}; do
            sample_name=$(basename "$bam" .bam)
            printf "%s\tplaceholder\n" "$sample_name" >> {output.roc}
        done
        """

rule samtoolsStats:
    input:
        bam=ANALYSIS_BAM_PATTERN,
        bai=ANALYSIS_BAI_PATTERN
    output:
        stat=final_path + "/bamcoverage/samtools/coverage/{sample}_samtools_stats.txt",
        idxstat=final_path + "/bamcoverage/samtools/{sample}_samtools_idxstats.txt",
        coverage=final_path + "/bamcoverage/samtools/{sample}_coverage.txt",
        coverage_histo=final_path + "/bamcoverage/samtools/{sample}_coverage_histo.txt"
    benchmark:
        "benchmarks/samtoolsStats/samtoolsStats_{sample}.txt"
    shell:
        """
        samtools stats {input.bam} > {output.stat}
        samtools idxstats {input.bam} > {output.idxstat}
        samtools coverage -H {input.bam} > {output.coverage}
        samtools coverage  -m --plot-depth -A {input.bam} > {output.coverage_histo}
        """

rule multiqcCoverage:
    input:
        samtools=expand(final_path + "/bamcoverage/samtools/coverage/{sample}_samtools_stats.txt",sample=sample),
        stats = expand(final_path + "/coverage/{sample}_bamtools_stats.txt",sample=sample)
    output:
        final_path + "/bamcoverage/multiqc_report.html"
    threads: 12
    resources:
        mem_mb=200000
    params:
        inpath1 = final_path + "/coverage",
        inpath2 = final_path + "/bamcoverage/samtools",
        outputpath = final_path + "/bamcoverage"
    shell:
        """
        multiqc --force {params.inpath1} {params.inpath2} --cl-config "log_filesize_limit: 100000000000" -o {params.outputpath}
        """