"""
Clean BED-based piawka rules:
 - convert intervals TSV -> BED
 - generate groups file(s)
 - run piawka once per mixed set and once per ploidy set (main and Tajima passes)
"""

import os
configfile: "config_main.yaml"

final_path = os.path.join(config["FINALOUTPUT"], config["PROJECT"])
PIAWKA_DIR = os.path.join(final_path, "piawka")
VARIANT_CALLER = str(config.get("variant_caller", "gatk")).strip().lower()


def _as_bool(value, default=False):
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "y", "on"}


FILTERING_CFG = config.get("VariantFiltering", {})
POPGEN_USE_AF_FILTER = _as_bool(FILTERING_CFG.get("popgen_stats_use_af_filtered", False), False)


def _caller_default_vcf():
    filename = "af_filtered.vcf.gz" if POPGEN_USE_AF_FILTER else "filtered.vcf.gz"
    if VARIANT_CALLER == "freebayes":
        return os.path.join(final_path, "freebayes", "final_vcf", filename)
    return os.path.join(final_path, "gatk4", "final_vcf", filename)

DEFAULT_VCF = _caller_default_vcf()
VCF = config.get("final_vcf_full") or config.get("final_vcf") or DEFAULT_VCF
METAFILE = config.get("METAFILE", config.get("metafile", None))
PIAWKA_CORES = int(config.get("piawka_cores", 2))
PIAWKA_MISS_GENERAL = float(config.get("piawka_miss_general", 0.5))
PIAWKA_MISS_TAJIMA = float(config.get("piawka_miss_tajima", 0.0))
PIAWKA_BED = config.get("piawka_bed", os.path.join(PIAWKA_DIR, "intervals.bed"))

# default window size (can be overridden in config under GenomeScan.window)
window_default = config.get("GenomeScan", {}).get("window", 10000)




if VCF is None:
    raise ValueError("final VCF path must be set (config['final_vcf_full'] or config['final_vcf'])")


def _ploidies():
    if METAFILE is None:
        return []
    import pandas as pd
    df = pd.read_csv(METAFILE, sep='\t', dtype=str)
    if 'ploidy' not in df.columns:
        return []
    return sorted(df['ploidy'].dropna().unique().tolist())


def _targets():
    t = [PIAWKA_BED,
         os.path.join(PIAWKA_DIR, "groups_mixed.txt"),
         os.path.join(PIAWKA_DIR, "groups_diploid_vs_tetraploid.txt"),
         os.path.join(PIAWKA_DIR, "mixed", "window", "piawka_main.tsv.gz"),
         os.path.join(PIAWKA_DIR, "mixed", "window", "piawka_tajima.tsv.gz"),
         os.path.join(PIAWKA_DIR, "mixed", "persite", "piawka_main_persite.tsv.gz"),
         os.path.join(PIAWKA_DIR, "mixed", "persite", "piawka_tajima_persite.tsv.gz"),
         os.path.join(PIAWKA_DIR, "ploidy", "window", "piawka_main.tsv.gz"),
         os.path.join(PIAWKA_DIR, "ploidy", "window", "piawka_tajima.tsv.gz"),
         os.path.join(PIAWKA_DIR, "ploidy", "persite", "piawka_main_persite.tsv.gz"),
         os.path.join(PIAWKA_DIR, "ploidy", "persite", "piawka_tajima_persite.tsv.gz")]
    return t



rule piawka_all:
    """Top-level target for piawka outputs."""
    input:
        lambda wc: _targets()


rule convert_intervals_to_bed:
    """Generate BED intervals from FASTA file using sliding windows."""
    input:
        fasta=config.get("GENOME")
    output:
        bed=PIAWKA_BED
    params:
        window=window_default
    run:
        import os
        
        os.makedirs(os.path.dirname(output.bed) or '.', exist_ok=True)
        
        with open(input.fasta, 'r') as fasta, open(output.bed, 'w') as out:
            chrom = None
            seq_len = 0
            
            for line in fasta:
                line = line.strip()
                if line.startswith('>'):
                    # Write windows for previous chromosome
                    if chrom is not None:
                        for start in range(0, seq_len, params.window):
                            end = min(start + params.window, seq_len)
                            out.write(f"{chrom}\t{start}\t{end}\n")
                    
                    # Start new chromosome
                    chrom = line[1:].split()[0]
                    seq_len = 0
                else:
                    seq_len += len(line)
            
            # Write windows for last chromosome
            if chrom is not None:
                for start in range(0, seq_len, params.window):
                    end = min(start + params.window, seq_len)
                    out.write(f"{chrom}\t{start}\t{end}\n")


rule generate_piawka_groups_mixed:
    input:
        metafile=METAFILE
    output:
        groups=os.path.join(PIAWKA_DIR, "groups_mixed.txt")
    run:
        import pandas as pd
        if not input.metafile:
            raise ValueError('METAFILE required')
        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        if 'sample' not in df.columns:
            raise ValueError('METAFILE requires sample column')
        pop_col = 'pop' if 'pop' in df.columns else ('population' if 'population' in df.columns else None)
        if pop_col is None:
            raise ValueError('METAFILE requires pop or population column')
        os.makedirs(os.path.dirname(output.groups) or '.', exist_ok=True)
        out = df[['sample', pop_col]].drop_duplicates()
        out.columns = ['sample', 'pop']
        out.to_csv(output.groups, sep='\t', header=False, index=False)



rule generate_piawka_groups_diploid_vs_tetraploid:
    """Create a groups file mapping samples to diploid or tetraploid for direct comparison.
       Output: results/piawka/groups_diploid_vs_tetraploid.txt (sample\tdiploid|tetraploid)"""
    input:
        metafile=METAFILE
    output:
        groups=os.path.join(PIAWKA_DIR, "groups_diploid_vs_tetraploid.txt")
    run:
        import pandas as pd, os
        if not input.metafile:
            raise ValueError('METAFILE required')
        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        for col in ['sample','ploidy']:
            if col not in df.columns:
                raise ValueError(f'METAFILE missing {col}')
        mapping = {'2':'diploid','4':'tetraploid'}
        df2 = df[['sample','ploidy']].drop_duplicates()
        df2['group'] = df2['ploidy'].map(lambda x: mapping.get(str(x), f"ploidy_{x}"))
        out = df2[['sample','group']]
        os.makedirs(os.path.dirname(output.groups) or '.', exist_ok=True)
        out.to_csv(output.groups, sep='\t', header=False, index=False)


rule piawka_mixed_main:
    input:
        vcf=VCF,
        groups=os.path.join(PIAWKA_DIR, "groups_mixed.txt"),
        bed=PIAWKA_BED
    output:
        tsv=os.path.join(PIAWKA_DIR, "mixed", "window", "piawka_main.tsv.gz")
    threads:
        50
    resources:
        mem_mb=100000,
        time="10-00:00"
    conda:
        "../env/piawka.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        piawka -v {input.vcf} -g {input.groups} -b {input.bed} -f -r -w -M {PIAWKA_MISS_GENERAL} -j {threads} | gzip -c > {output.tsv}
        """


rule piawka_mixed_tajima:
    input:
        vcf=VCF,
        groups=os.path.join(PIAWKA_DIR, "groups_mixed.txt"),
        bed=PIAWKA_BED
    output:
        tsv=os.path.join(PIAWKA_DIR, "mixed", "window", "piawka_tajima.tsv.gz")
    threads:
        50
    resources:
        mem_mb=100000,
        time="10-00:00"
    conda:
        "../env/piawka.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        piawka -v {input.vcf} -g {input.groups} -b {input.bed} -T -M {PIAWKA_MISS_TAJIMA} -j {threads} | gzip -c > {output.tsv}
        """


rule piawka_mixed_persite:
    """Run piawka per-site values (persite) for mixed-ploidy main stats."""
    input:
        vcf=VCF,
        groups=os.path.join(PIAWKA_DIR, "groups_mixed.txt"),
        bed=PIAWKA_BED
    output:
        tsv=os.path.join(PIAWKA_DIR, "mixed", "persite", "piawka_main_persite.tsv.gz")
    threads:
        50
    resources:
        mem_mb=100000,
        time="10-00:00"
    conda:
        "../env/piawka.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        piawka -v {input.vcf} -g {input.groups} -f -r -w -M {PIAWKA_MISS_GENERAL} -1 -j {threads} | gzip -c > {output.tsv}
        """


rule piawka_mixed_persite_tajima:
    """Run piawka per-site Tajima D (persite) with strict no-missing."""
