    """Run piawka per-site values (persite) for mixed-ploidy main stats."""
    input:
        vcf=VCF,
        groups="results/piawka/groups_mixed.txt",
        bed=PIAWKA_BED
    output:
        tsv="results/piawka/mixed/persite/piawka_main_persite.tsv.gz"
    threads:
        50
    resources:
        mem_mb=100000,
        time="10-00:00"
    conda:
        "../env/piawka.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        piawka -v {input.vcf} -g {input.groups} -f -r -w -M {PIAWKA_MISS_GENERAL} -1 -j {threads} | gzip -c > {output.tsv}
        """


