rule ApplyFilter_variants:
    input:
        final_path + "/gatk4/final_vcf/mark-filter_variant.vcf.gz",
        final_path + "/gatk4/final_vcf/mark-filter_variant.vcf.gz.tbi"
    output:
        temp(final_path + "/gatk4/final_vcf/filtered_variant.vcf.gz"),
        temp(final_path + "/gatk4/final_vcf/filtered_variant.vcf.gz.tbi")
    benchmark:
        "benchmarks/ApplyFilter/ApplyFilter_variants.txt"
    threads:
        30
    resources:
        mem_mb = 8000,
        time = "3-0"
    params:
        outputpath = final_path + "/gatk4/final_vcf/",
        high_heterozygosity = config["HaplotypeCaller"]["high_heterozygosity"]
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
            bcftools filter --threads {threads} -O u --exclude 'FILTER != "PASS"' {input[0]} |\
            bcftools view --threads {threads} -O z > {output[0]}

        bcftools index {output[0]}
        bcftools index --tbi {output[0]}
        
        """

