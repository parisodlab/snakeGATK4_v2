rule MergeVariantAndInvariant:
    input:
        final_path + "/gatk4/final_vcf/filtered_variant.vcf.gz",
        final_path + "/gatk4/final_vcf/filtered_variant.vcf.gz.tbi",
        final_path + "/gatk4/final_vcf/filtered_invariant.vcf.gz",
        final_path + "/gatk4/final_vcf/filtered_invariant.vcf.gz.tbi"
    output:
        final_path + "/gatk4/final_vcf/filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/filtered.vcf.gz.tbi",
        final_path + "/gatk4/final_vcf/filtered.stats.txt"
    benchmark:
        "benchmarks/MergeVariantAndInvariant/MergeVariantAndInvariant.txt"
    threads:
        20
    resources:
        mem_mb = 8000,
        time = "3-0"
    params:
        outputpath = final_path + "/gatk4/final_vcf/",
        high_heterozygosity = config["HaplotypeCaller"]["high_heterozygosity"],
        high_missing = config["HaplotypeCaller"]["high_missing"]
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        bcftools concat -a --threads {threads} -O u {input[0]} {input[2]} |\
        bcftools filter -O u --threads {threads} --soft-filter='high_heterozygosity' --mode + --include '( COUNT(GT="het") / N_SAMPLES ) <= {params.high_heterozygosity}' |\
        bcftools filter --threads {threads} --soft-filter='high_missing' --mode + --include 'F_MISSING  <= {params.high_missing}' -O z > {output[0]}
        bcftools index {output[0]}
        bcftools index --tbi {output[0]}
        bcftools stats --threads {threads} -s- --verbose {output[0]} > {output[2]}
        """
    



# Run bcftools stats (temporary)
rule bcftools_stats:
    input:
        vcf = final_path + "/gatk4/final_vcf/filtered.vcf.gz",
        idx = final_path + "/gatk4/final_vcf/filtered.vcf.gz.tbi"
    output:
        temp(final_path + "/gatk4/final_vcf/per_sample/{sample}_dp.txt")
    threads:
        30
    params:
        sample = lambda wildcards: wildcards.sample
    shell:
        """
        tmp_vcf=$(mktemp "$(dirname {output})/{params.sample}.XXXXXX.vcf.gz")
        trap 'rm -f "$tmp_vcf" "$tmp_vcf.tbi"' EXIT
        bcftools view -s {params.sample} {input.vcf} -Oz --threads {threads} -o "$tmp_vcf"
        : > {output}
        bcftools stats -s- "$tmp_vcf" | grep '^DP' > {output} || true
        """


# Combine DP stats (kept)
rule combine_dp:
    input:
        dp_files = expand(final_path + "/gatk4/final_vcf/per_sample/{sample}_dp.txt", sample=sample)
    output:
        final_path + "/gatk4/final_vcf/combined_dp_filtered.tsv"
    run:
        import os
        import pandas as pd
        all_dp = []
        for file in input.dp_files:
            sample = file.split('/')[-1].replace('_dp.txt','')
            if os.path.getsize(file) == 0:
                df = pd.DataFrame([
                    {
                        'Bin': 0,
                        'NumGeno': 0,
                        'fracGeno': 0.0,
                        'NumSites': 0,
                        'fracSites': 0.0,
                        'Sample': sample,
                    }
                ])
                all_dp.append(df)
                continue

            df = pd.read_csv(file, sep='\t', header=None)
            df = df[[2,3,4,5,6]]
            df.columns = ['Bin','NumGeno','fracGeno', 'NumSites','fracSites']
            df = df[:-1]
            if df.empty:
                df = pd.DataFrame([
                    {
                        'Bin': 0,
                        'NumGeno': 0,
                        'fracGeno': 0.0,
                        'NumSites': 0,
                        'fracSites': 0.0,
                        'Sample': sample,
                    }
                ])
            else:
                df['Bin'] = df['Bin'].astype(int)
                df['NumSites'] = df['NumSites'].astype(int)
                df['Sample'] = sample
            all_dp.append(df)
        df_all = pd.concat(all_dp, ignore_index=True)
        df_all.to_csv(output[0], sep='\t', index=False)

# Plot DP (kept)
rule plot_dp:
    input:
        combined_dp=final_path + "/gatk4/final_vcf/combined_dp_filtered.tsv"
    output:
        final_path + "/gatk4/final_vcf/dp_distribution_numgeno.pdf",
        final_path + "/gatk4/final_vcf/dp_distribution_numsites.pdf"
    conda:
        "../env/plot_dp.yaml"
    script:
        "../scripts/dp_histogram_modes.py"



checkpoint split_by_ploidy:
    input:
        vcf = final_path + "/gatk4/final_vcf/filtered.vcf.gz"
    output:
        directory(final_path + "/gatk4/final_vcf/vcfs_by_ploidy_raw")
    threads:
        30
    run:
        import os
        os.makedirs(output[0], exist_ok=True)
        for ploidy in ploidies:
            ploidy_samples = [s for s, p in samples_ploidy.items() if str(p) == str(ploidy)]
            sample_list = ",".join(ploidy_samples)
            out_vcf = os.path.join(output[0], f"ploidy_{ploidy}.vcf.gz")
            shell("bcftools view -s {sample_list} {input.vcf} -O z --threads {threads} -o {out_vcf}")


# Function to get VCFs per ploidy from checkpoint
def ploidy_vcf(wildcards):
    ck = checkpoints.split_by_ploidy.get().output[0]
    pldy, = glob_wildcards(os.path.join(ck, "ploidy_{ploidy}.vcf.gz"))
    return expand(os.path.join(ck, "ploidy_{ploidy}.vcf.gz"), ploidy=pldy)


# Depth filtering per ploidy
rule depth_filter:
    input:
        vcf=lambda wildcards: os.path.join(checkpoints.split_by_ploidy.get().output[0], f"ploidy_{wildcards.ploidy}.vcf.gz")
    output:
        filtered_vcf = temp(final_path + "/gatk4/final_vcf/vcfs_by_ploidy/ploidy_{ploidy}.filtered.vcf.gz"),
        filtered_vcf_tbi = temp(final_path + "/gatk4/final_vcf/vcfs_by_ploidy/ploidy_{ploidy}.filtered.vcf.gz.tbi")
    threads:
        30
    run:
        import os
        import re
        vcf = input.vcf if isinstance(input.vcf, str) else input[0]
        name = Path(vcf).name 
        base = re.sub(r'\.vcf(?:\.gz)?$', '', name)
        ploidy = base.split("_", 1)[1]  # assumes filename: ploidy_<ploidy>.vcf
        dp_min = ploidy_dp[ploidy]["min"]
        dp_max = ploidy_dp[ploidy]["max"]
        out_vcf = output.filtered_vcf
        os.makedirs(os.path.dirname(out_vcf), exist_ok=True)
        # run bcftools to produce a gzipped filtered VCF matching the declared output
        shell(f"""
            
            bcftools filter --threads {threads} -e 'FORMAT/DP<{dp_min}' --set-GTs . -Ou {vcf} | \
            bcftools filter --threads {threads} -e 'FORMAT/DP>{dp_max}' --set-GTs . -Oz -o {out_vcf}
        """)
        shell(f"bcftools index --tbi {out_vcf}")

rule merge_filtered_vcfs:
    input:
        vcfs = expand(final_path + "/gatk4/final_vcf/vcfs_by_ploidy/ploidy_{ploidy}.filtered.vcf.gz", ploidy=ploidies)
    output:
        merged = final_path + "/gatk4/final_vcf/merged.vcf.gz"
    threads:
        50
    run:
        import tempfile, os
        from pathlib import Path

        vcfs = input.vcfs
        if len(vcfs) == 0:
            raise ValueError("No filtered VCFs found to merge!")
        elif len(vcfs) == 1:
            shell("cp {vcfs[0]} {output.merged}")
        else:
            tmpdir = tempfile.mkdtemp()
            fixed_vcfs = []

            for vcf in vcfs:
                base = Path(vcf).stem.replace(".vcf", "")
                header = os.path.join(tmpdir, f"{base}.header.txt")
                fixed = os.path.join(tmpdir, f"{base}.fixed.vcf.gz")

                # extract header, fix AD, and reheader
                shell("bcftools view -h {vcf} > {header}")
                shell("sed -i 's/##FORMAT=<ID=AD,Number=R/##FORMAT=<ID=AD,Number=./' {header}")
                shell("""bcftools reheader -h {header} {vcf} | \
                bcftools annotate --threads {threads} -x FORMAT/PL -O z -o {fixed} """)
                shell("bcftools index --threads {threads} --tbi {fixed}")

                fixed_vcfs.append(fixed)

            # merge fixed vcfs
            vcfs_str = " ".join(fixed_vcfs)
            shell("bcftools merge {vcfs_str} --threads {threads} -O z -o {output.merged}")

            shell("rm -rf {tmpdir}")



rule Filter_missingness:
    input:
        vcf=final_path + "/gatk4/final_vcf/merged.vcf.gz"
    output:
        final_path + "/gatk4/final_vcf/missingness_filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/missingness_filtered.stats.txt"
    benchmark:
        "benchmarks/FilterVCFminAF_and_missingness/Filter_missingness.txt"
    threads:
        8
    resources:
        mem_mb = 8000,
        time = "10-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/",
        missingness_expr = f"F_MISSING <= {MISSINGNESS_MAX}"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        bcftools view --threads {threads} -O v -i '{params.missingness_expr}'  {input[0]} |\
            vcffixup - | \
            bcftools view --threads {threads} -O z > {params.outputpath}missingness_filtered.vcf.gz
        bcftools index {params.outputpath}missingness_filtered.vcf.gz
        bcftools stats -s- --threads {threads} --verbose {params.outputpath}missingness_filtered.vcf.gz > {params.outputpath}missingness_filtered.stats.txt
        """


rule mean_dp_missingness_per_sample:
    input:
        vcf=rules.Filter_missingness.output[0]
    output:
        tsv=final_path + "/gatk4/final_vcf/missingness_filtered.mean_dp_per_sample.tsv"
    conda:
        "../env/python-data.yaml"
    params:
        label="missingness_filtered"
    script:
        "../scripts/mean_dp_per_sample_from_vcf.py"


rule filter_BIALLELIC_SNP:
    """
    Select biallelic SNPs from the missingness-filtered VCF and produce a
    bgzipped VCF, its index, and bcftools statistics.
    """
    input:
        vcf = final_path + "/gatk4/final_vcf/missingness_filtered.vcf.gz"
    output:
        final_path + "/gatk4/final_vcf/biallelic_snp_filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/biallelic_snp_filtered.vcf.gz.tbi",
        final_path + "/gatk4/final_vcf/biallelic_snp_filtered.stats.txt"
    threads:
        30
    resources:
        mem_mb = 8000,
        time = "2-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        r"""
        # select only SNPs and require exactly two alleles (biallelic)
        bcftools view --threads {threads} -v snps -m2 -M2 {input.vcf} -Oz -o {output[0]}
        bcftools index --tbi {output[0]}
        bcftools stats --threads {threads} -s- --verbose {output[0]} > {output[2]}
        """


rule mean_dp_biallelic_snp_per_sample:
    input:
        vcf=rules.filter_BIALLELIC_SNP.output[0]
    output:
        tsv=final_path + "/gatk4/final_vcf/biallelic_snp_filtered.mean_dp_per_sample.tsv"
    conda:
        "../env/python-data.yaml"
    params:
        label="biallelic_snp_filtered"
    script:
        "../scripts/mean_dp_per_sample_from_vcf.py"


rule combine_mean_dp_per_sample_qc:
    input:
        missingness=rules.mean_dp_missingness_per_sample.output.tsv,
        biallelic=rules.mean_dp_biallelic_snp_per_sample.output.tsv
    output:
        final_path + "/gatk4/final_vcf/mean_dp_per_sample_qc.tsv"
    run:
        missing_df = pd.read_csv(input.missingness, sep='\t').rename(
            columns={
                'mean_dp': 'mean_dp_missingness_snp',
                'sites_with_dp': 'sites_with_dp_missingness_snp',
                'fraction_sites_with_dp': 'fraction_sites_with_dp_missingness_snp',
            }
        )
        biallelic_df = pd.read_csv(input.biallelic, sep='\t').rename(
            columns={
                'mean_dp': 'mean_dp_biallelic_snp',
                'sites_with_dp': 'sites_with_dp_biallelic_snp',
                'fraction_sites_with_dp': 'fraction_sites_with_dp_biallelic_snp',
            }
        )
        merged = missing_df.drop(columns=['vcf_label']).merge(
            biallelic_df.drop(columns=['vcf_label']),
            on='sample',
            how='outer'
        )
        merged.to_csv(output[0], sep='\t', index=False)

rule select_indels:
    input:
        vcf=final_path + "/gatk4/final_vcf/missingness_filtered.vcf.gz"
    output:
        indels=temp(final_path + "/gatk4/final_vcf/indels.raw.vcf.gz"),
        stats=final_path + "/gatk4/final_vcf/indels.raw.stats.txt"
    threads:
        8
    conda:
        "../env/gatk4_calling_env.yaml"
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    shell:
        """
        bcftools view -v indels --threads {threads} -Oz -o {output.indels} {input.vcf}
        bcftools index --tbi {output.indels}
        bcftools stats -s- --threads {threads} --verbose {output.indels} > {output.stats}
        """


rule decompose_indels:
    input:
        indels=rules.select_indels.output.indels
    output:
        decomposed=temp(final_path + "/gatk4/final_vcf/indels.decomposed.vcf.gz")
    threads:
        8
    params:
        ref = GENOME
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        # decompose multiallelic records and left-align where possible
        bcftools norm -m -any -f {params.ref} {input.indels} -Oz -o {output.decomposed}
        bcftools index --tbi {output.decomposed}
        """


rule mask_low_support_genotypes_indels:
    """Set genotypes with too-low per-sample DP to missing (config-driven).
    The config should contain: config['INDEL']['min_support'] (default 5)
    """
    input:
        decomposed=rules.decompose_indels.output.decomposed
    output:
        dp_masked=temp(final_path + "/gatk4/final_vcf/indels.dp_masked.vcf.gz")
    threads:
        8
    params:
        min_support = config.get("GATK").get('INDEL', {}).get('min_support', 5)
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        # set genotypes with FORMAT/DP < min_support to missing
        bcftools filter --threads {threads} -e 'FMT/DP<{params.min_support}' --set-GTs . -Oz -o {output.dp_masked} {input.decomposed}
        bcftools index --tbi {output.dp_masked}
        """


rule compute_mean_coverage:
    """Compute mean site depth (INFO/DP) from a coverage vcf (config-driven).
    config['INDEL'].get('coverage_vcf') can point to the VCF to use; fallback to missingness_filtered.vcf.gz
    """
    output:
        final_path + "/gatk4/final_vcf/mean_coverage.txt"
    params:
        coverage_vcf = final_path + "/gatk4/final_vcf/missingness_filtered.vcf.gz"
    threads:
        2
    resources:
        mem_mb = 50000,
        time = "1-00:00"
    conda:
        "../env/gatk4_calling_env.yaml"
    script:
        "../scripts/compute_mean_coverage.py"


rule filter_indels_strict:
    """Apply GATK-like site filters, excess-depth exclusion (2x mean), and indel length limit.
    Produces the final indel VCF and stats.
    """
    input:
        dp_masked=rules.mask_low_support_genotypes_indels.output.dp_masked,
        mean_cov=rules.compute_mean_coverage.output[0]
    output:
        final_path + "/gatk4/final_vcf/indel_filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/indel_filtered.stats.txt"
    threads:
        16
    resources:
        mem_mb = 16000,
        time = "4-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/",
        # GATK-like thresholds
        FS = 40.0,
        SOR = 3.0,
        MQ = 30,
        MQRankSum = -12.5,
        QD = 2.0,
        ReadPosRankSum = -4.0,
        excess_mult =  2,
        max_len = 20
    conda:
        "../env/gatk4_calling_env.yaml"
    script:
        "../scripts/filter_indels_strict.py"


rule FilterVCFminAF:
    input:
        vcf=final_path + "/gatk4/final_vcf/biallelic_snp_filtered.vcf.gz"
    output:
        final_path + "/gatk4/final_vcf/af_filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/af_filtered.vcf.gz.tbi",
        final_path + "/gatk4/final_vcf/af_filtered.stats.txt"
    benchmark:
        "benchmarks/FilterVCFminAF_and_missingness/FilterVCFminAF.txt"
    threads:
        30
    resources:
        mem_mb = 8000,
        time = "2-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/",
        af_enabled = str(NEUTRAL_AF_ENABLED).lower(),
        min_af = NEUTRAL_MIN_AF,
        max_af = NEUTRAL_MAX_AF
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        if [ "{params.af_enabled}" = "true" ]; then
            bcftools view --threads {threads} -O v --min-af {params.min_af} --max-af {params.max_af} {input[0]} |\
                vcffixup - | \
                bcftools view --threads {threads} -O z > {params.outputpath}af_filtered.vcf.gz
        else
            bcftools view --threads {threads} -O z -o {params.outputpath}af_filtered.vcf.gz {input[0]}
        fi
        bcftools index --tbi {params.outputpath}af_filtered.vcf.gz
        bcftools stats -s- --threads {threads} --verbose {params.outputpath}af_filtered.vcf.gz > {params.outputpath}af_filtered.stats.txt
        """

rule filter_4_fold_degenerate:
    input:
        reference=GENOME,
        vcf=final_path + "/gatk4/final_vcf/af_filtered.vcf.gz",
        degenerate=final_path + "/degeneracy/degeneracy-fourfold.bed"
    output:
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.vcf.gz",
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.stats.txt"
    benchmark:
        "benchmarks/Filter4FoldDegenerate/Filter4FoldDegenerate.txt"
    threads:
        8
    resources:
        mem_mb = 20000,
        time = "10-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        gatk SelectVariants \
            -R {input[0]} \
            -V {input[1]} \
            -O {params.outputpath}4_fold_degenerate_filtered.vcf.gz \
            -L {input[2]} \
            --select-type SNP \
            --restrict-alleles-to BIALLELIC
        bcftools stats -s- --threads {threads} --verbose {params.outputpath}4_fold_degenerate_filtered.vcf.gz > {params.outputpath}4_fold_degenerate_filtered.stats.txt
        """

rule LD_pruning:
    input:
        reference=GENOME,
        vcf=final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.vcf.gz"
    output:
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.vcf.gz",
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.stats.txt"
    benchmark:
        "benchmarks/LD_pruning/LD_pruning.txt"
    threads:
        30
    resources:
        mem_mb = 20000,
        time = "2-00:00"
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        variant_count=$(bcftools view -H {input.vcf} | wc -l)
        if [ "$variant_count" -eq 0 ]; then
            bcftools view -Oz -o {params.outputpath}4_fold_degenerate_filtered.ld_pruned.vcf.gz {input.vcf}
            bcftools index --tbi {params.outputpath}4_fold_degenerate_filtered.ld_pruned.vcf.gz
        else
            Rscript scripts/LD_prunning.R {input.vcf} {params.outputpath}4_fold_degenerate_filtered.ld_pruned.gds {params.outputpath}
            gatk SelectVariants \
                -R {input.reference} \
                -V {input.vcf} \
                -O {params.outputpath}4_fold_degenerate_filtered.ld_pruned.vcf.gz \
                -L {params.outputpath}pruned_snps.intervals
            bcftools index --tbi {params.outputpath}4_fold_degenerate_filtered.ld_pruned.vcf.gz
        fi
        bcftools stats -s- --threads {threads} --verbose {params.outputpath}4_fold_degenerate_filtered.ld_pruned.vcf.gz > {params.outputpath}4_fold_degenerate_filtered.ld_pruned.stats.txt
        """


rule make_nj_tree:
    input:
        vcf=final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.vcf.gz",
        metadata=METAFILE
    output:
        final_path + "/phylogeny/nj_tree.pdf"
    benchmark:
        "benchmarks/vcf_annotation/nj_tree.txt"
    threads:
        4
    resources:
        mem_mb = 16000,
        time = "2-0"
    conda:
        "../env/make_nj_tree.yaml"
    shell:
        """
        Rscript scripts/make_nj_tree.R {input.vcf} {input.metadata} {output}
        """



		
rule make_depth_mask:
    """
    Compute depth-based mask files from the merged VCF produced by
    MergeVariantAndInvariant. Outputs use fixed 'merged' prefixes.
    """
    input:
        merged = final_path + "/gatk4/final_vcf/filtered.vcf.gz",
        script = "scripts/make_depth_mask.py"
    output:
        touch(DEPTHMASK_DIR + "/make_depth_mask.ok")
        # depth_out = DEPTHMASK_DIR + "/merged_dm_out.tsv",
        # depth_counts = DEPTHMASK_DIR + "/merged_dm_counts.tsv",
        # depth_hist = DEPTHMASK_DIR + "/merged_dm_hist.tsv",
        # depth_bed = DEPTHMASK_DIR + "/merged_dm.bed",
        # stats = DEPTHMASK_DIR + "/merged_dm_counts_out.tsv.sample_depth_stats.txt",
        # summary = DEPTHMASK_DIR + "/merged_dm_counts_out.tsv.sample_mean_sd.tsv"
    resources:
        mem_mb = 200000,
        time = "4-00:00"
    threads: 2
    conda:
        "../env/make_depth_mask_env.yaml"
    log:
        LOG_DIR + "/make_depth_mask.log"
    params:
        outputpath = DEPTHMASK_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p {DEPTHMASK_DIR}
        # estimate variant sites
        if [ -s "{input.merged}" ]; then
            n_loci=$(zcat {input.merged} | grep -c "^[^#]" || true)
        else
            n_loci=1000000
        fi

        PYTHONUNBUFFERED=1 python3 -u {input.script} \
            -v {input.merged} \
            -o {params.outputpath}/out_file_dm.tsv \
            -c {params.outputpath}/counts_out.tsv \
            -p {params.outputpath}/hist_out.tsv \
            -n {DEPTHMASK_N} \
            -l $n_loci \
            -m {DEPTHMASK_MIN_DEPTH} \
            --stats {params.outputpath}/counts_out.tsv.sample_depth_stats.txt \
            --summary {params.outputpath}/counts_out.tsv.sample_mean_sd.tsv \
            --bed out_file_merged.bed 

        """


# --- het mask rule ---------------------------------------------------------
# Uses the provided scripts/make_het_mask.py to compute per-site heterozygosity
# and write a BED of sites to DEPTHMASK_DIR/merged_hetmask.bed


rule make_het_mask:
    input:
        merged = final_path + "/gatk4/final_vcf/filtered.vcf.gz",
        samples = rules.write_het_group_samples.output.samples,
        annotation = ANNOTATION,
        script = "scripts/make_het_mask_new.py"
    output:
        het_tsv = DEPTHMASK_DIR + "/merged_het_{group_id}.tsv"
    threads: 1
    resources:
        mem_mb = 200000,
        time = "1-00:00"
    log:
        LOG_DIR + "/make_het_mask.{group_id}.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {DEPTHMASK_DIR}

        # run het mask generator; missing threshold HET_MISSING (default 0.33)
        PYTHONUNBUFFERED=1 python3 -u {input.script} -v {input.merged} -o out_het.tsv -s {input.samples} -a {input.annotation} -m {HET_MISSING} 2>&1 | tee {log}

        # # expected output: contig, start, end, ...; convert to bed of sites
        # awk '{{print $1"\t"$2"\t"$3}}' out_het.tsv > out_het.bed
        # bedops -m out_het.bed > out_het_merged.bed

        mv out_het.tsv {output.het_tsv}
        """


rule plot_pairwise:
    input:
        het_tsv = DEPTHMASK_DIR + "/merged_het_{group_id}.tsv",
        script = "scripts/make_pairwise_plots.py"
    output:
        touch = VCF_FILTERED + "/plots/{group_id}/pairwise.ok"
    threads: 1
    log:
        LOG_DIR + "/plot_pairwise.{group_id}.log"
    params:
        group_id = lambda wc: wc.group_id
    shell:
        r"""
        set -euo pipefail
        mkdir -p {VCF_FILTERED}/plots/{params.group_id}
        mkdir -p {LOG_DIR}
        python3 {input.script} {input.het_tsv} {VCF_FILTERED}/plots/{params.group_id} merged &>> {log}
        touch {output.touch}
        """


rule plot_per_gene:
    input:
        het_tsv = DEPTHMASK_DIR + "/merged_het_{group_id}.tsv",
        script = "scripts/make_per_gene_plots.py"
    output:
        touch = VCF_FILTERED + "/plots/{group_id}/per_gene.ok"
    threads: 1
    log:
        LOG_DIR + "/plot_per_gene.{group_id}.log"
    params:
        group_id = lambda wc: wc.group_id
    shell:
        r"""
        set -euo pipefail
        mkdir -p {VCF_FILTERED}/plots/{params.group_id}
        mkdir -p {LOG_DIR}
        python3 {input.script} {input.het_tsv} {VCF_FILTERED}/plots/{params.group_id} merged &>> {log}
        touch {output.touch}
        """


rule plot_mean:
    input:
        het_tsv = DEPTHMASK_DIR + "/merged_het_{group_id}.tsv",
        script = "scripts/make_mean_per_gene_plots.py"
    output:
        touch = VCF_FILTERED + "/plots/{group_id}/mean_per_gene.ok"
    threads: 1
    log:
        LOG_DIR + "/plot_mean.{group_id}.log"
    params:
        group_id = lambda wildcards: wildcards.group_id
    shell:
        r"""
        set -euo pipefail
        mkdir -p {VCF_FILTERED}/plots/{params.group_id}
        mkdir -p {LOG_DIR}
        python3 {input.script} {input.het_tsv} {VCF_FILTERED}/plots/{params.group_id} merged &>> {log}
        touch {output.touch}
        """


rule MultiQC:
    input:
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.vcf.gz"
    output:
        final_path + "/gatk4/final_vcf/multiqc_report.html"
    conda:
        "../env/gatk4_calling_env.yaml"
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    shell:
        """
                if ! multiqc {params.outputpath} -o {params.outputpath}; then
                        cat > {output} <<'EOF'
<html>
    <head><title>MultiQC placeholder</title></head>
    <body>
        <h1>MultiQC placeholder</h1>
        <p>No plottable QC datasets were available for this filtered smoke-test VCF.</p>
    </body>
</html>
EOF
                fi
        """