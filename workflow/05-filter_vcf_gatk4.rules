import pandas as pd
import os
from pathlib import Path

configfile: "config_main.yaml"

METAFILE = config["METAFILE"]
GENOME = config["GENOME"]
final_path = os.path.join(config["FINALOUTPUT"], config["PROJECT"])

# Load metadata once at parse-time (read-only). Any derived files are written by rules.
samples = pd.read_csv(METAFILE, sep='\t', dtype=str)
if "sample" not in samples.columns:
    raise ValueError("Metadata file must contain a 'sample' column")
samples["sample"] = samples["sample"].astype(str)
samples = samples.dropna(subset=["sample"]).drop_duplicates(subset=["sample"]).reset_index(drop=True)

sample = samples["sample"].tolist()

POP_COL = "pop" if "pop" in samples.columns else ("population" if "population" in samples.columns else None)
if POP_COL is None:
    raise ValueError("Metadata file must contain a 'pop' or 'population' column")

PLOIDY_COL = "ploidy" if "ploidy" in samples.columns else None
if PLOIDY_COL is None:
    raise ValueError("Metadata file must contain a 'ploidy' column")

def _norm_ploidy(p):
    p = str(p)
    pl = p.strip().lower()
    if pl in {"2", "diploid", "di", "dip"}:
        return "2"
    if pl in {"4", "tetraploid", "tetra", "tet"}:
        return "4"
    return p

samples_ploidy = {s: _norm_ploidy(p) for s, p in zip(samples["sample"], samples[PLOIDY_COL].astype(str))}
ploidies = sorted(set(samples_ploidy.values()))

# Where derived metadata files live (stage-05 outputs)
META_DIR = os.path.join(final_path, "metadata")
SAMPLE_POP_UNIQUE = os.path.join(META_DIR, "sample_pop_unique.tsv")
SAMPLE_PLOIDY_UNIQUE = os.path.join(META_DIR, "sample_ploidy_unique.tsv")
SAMPLE_PLOIDY_COLCHITETRA = os.path.join(META_DIR, "sample_ploidy_unique_colchitetra.tsv")

# Heterozygosity mask: define groups explicitly; default is a single group over all samples.
HET_GROUP_IDS = config.get("HET_GROUP_IDS")
if not HET_GROUP_IDS:
    HET_GROUP_IDS = ["all"]
HET_GROUPS_DIR = os.path.join(META_DIR, "het_groups")


def _as_bool(value, default=False):
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "y", "on"}


FILTERING_CFG = config.get("VariantFiltering", {})
MISSINGNESS_MAX = float(FILTERING_CFG.get("missingness_max", 0.5))
NEUTRAL_AF_CFG = FILTERING_CFG.get("neutral_af_filter", {})
NEUTRAL_AF_ENABLED = _as_bool(NEUTRAL_AF_CFG.get("enabled", True), True)
NEUTRAL_MIN_AF = float(NEUTRAL_AF_CFG.get("min_af", 0.025))
NEUTRAL_MAX_AF = float(NEUTRAL_AF_CFG.get("max_af", 0.975))


# samples_ploidy: dict(sample -> ploidy as str)
# ploidies: sorted unique ploidy identifiers (as str)


# Depth thresholds per ploidy
ploidy_dp = {
    "2": {"min": config["GATK"]["min_depth"]["di"], "max": config["GATK"]["max_depth"]["di"]},
    "4": {"min": config["GATK"]["min_depth"]["tetra"], "max": config["GATK"]["max_depth"]["tetra"]}
}


# --- depth/het mask integration variables -----------------------------------
# Paths: point at the project's final VCF and create dedicated depth_masks and logs
VCF_FILTERED = final_path + "/gatk4/final_vcf"
VCF_MERGED = VCF_FILTERED + "/filtered.vcf.gz"
DEPTHMASK_DIR = final_path + "/gatk4/depth_masks"
LOG_DIR = final_path + "/gatk4/logs"

# Resource and parameter defaults (can be overridden in config under RESOURCES)
make_depth_mask_mem_mb = config.get('RESOURCES', {}).get('make_depth_mask_mem_mb', 4000)
make_depth_mask_runtime = config.get('RESOURCES', {}).get('make_depth_mask_runtime', '3600')
TOTAL_SAMPLES = len(sample)
DEPTHMASK_N = config.get('DEPTHMASK_N', max(1, int(round(0.2 * TOTAL_SAMPLES))))

# default minimum per-sample depth to consider when computing means/std
# fallback to the smallest per-ploidy min depth declared in config, or 1
MIN_DEPTH_DEFAULT = min([v['min'] for v in ploidy_dp.values()]) if len(ploidy_dp) > 0 else 1
DEPTHMASK_MIN_DEPTH = config.get('DEPTHMASK_MIN_DEPTH', MIN_DEPTH_DEFAULT)

# Het-mask related defaults
ANNOTATION = config.get('ANNOTATION', '')
HET_MISSING = config.get('HET_MISSING', 0.33)


GROUP_IDS = HET_GROUP_IDS


rule write_sample_pop_unique:
    """Write a two-column sample<tab>pop mapping derived from METAFILE.

    Output has no header for compatibility with downstream scripts.
    """
    input:
        metafile=METAFILE
    output:
        tsv=SAMPLE_POP_UNIQUE
    run:
        import pandas as pd
        import os

        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        if "sample" not in df.columns:
            raise ValueError("METAFILE missing 'sample' column")
        pop_col = "pop" if "pop" in df.columns else ("population" if "population" in df.columns else None)
        if pop_col is None:
            raise ValueError("METAFILE missing 'pop' or 'population' column")

        outdir = os.path.dirname(output.tsv)
        os.makedirs(outdir, exist_ok=True)
        out = df[["sample", pop_col]].dropna().drop_duplicates()
        out.columns = ["sample", "pop"]
        out.to_csv(output.tsv, sep='\t', index=False, header=False)


rule write_sample_ploidy_unique:
    """Write sample<tab>ploidy mappings derived from METAFILE.

    Produces both:
    - sample_ploidy_unique.tsv: ploidy normalized to diploid/tetraploid when ploidy is 2/4
    - sample_ploidy_unique_colchitetra.tsv: subset for samples ending with CT (empty file if none)
    """
    input:
        metafile=METAFILE
    output:
        ploidy=SAMPLE_PLOIDY_UNIQUE,
        colchitetra=SAMPLE_PLOIDY_COLCHITETRA
    run:
        import pandas as pd
        import os

        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        for col in ("sample", "ploidy"):
            if col not in df.columns:
                raise ValueError(f"METAFILE missing '{col}' column")

        outdir = os.path.dirname(output.ploidy)
        os.makedirs(outdir, exist_ok=True)

        out = df[["sample", "ploidy"]].dropna().drop_duplicates()
        out.columns = ["sample", "ploidy"]
        out["ploidy"] = out["ploidy"].astype(str).replace({'2': 'diploid', '4': 'tetraploid'})
        out.to_csv(output.ploidy, sep='\t', index=False, header=False)

        ct = out[out["sample"].astype(str).str.endswith("CT")].copy()
        ct["ploidy"] = "colchitetraploid"
        # Always write file for stable downstream dependencies
        ct.to_csv(output.colchitetra, sep='\t', index=False, header=False)


rule write_het_group_samples:
    """Write sample-pop mapping file for heterozygosity mask scripts.

    Default group_id=all includes all rows. For any other group_id, the rule
    filters to samples where pop == group_id (using 'pop' or 'population').
    """
    input:
        metafile=METAFILE
    output:
        samples=os.path.join(HET_GROUPS_DIR, "sample_{group_id}.tsv")
    run:
        import pandas as pd
        import os

        df = pd.read_csv(input.metafile, sep='\t', dtype=str)
        if "sample" not in df.columns:
            raise ValueError("METAFILE missing 'sample' column")
        pop_col = "pop" if "pop" in df.columns else ("population" if "population" in df.columns else None)
        if pop_col is None:
            raise ValueError("METAFILE missing 'pop' or 'population' column")

        sub = df[["sample", pop_col]].dropna().drop_duplicates()
        sub.columns = ["sample", "pop"]
        if wildcards.group_id != "all":
            sub = sub.loc[sub["pop"].astype(str) == str(wildcards.group_id)]
        os.makedirs(os.path.dirname(output.samples), exist_ok=True)
        sub.to_csv(output.samples, sep='\t', index=False, header=False)


