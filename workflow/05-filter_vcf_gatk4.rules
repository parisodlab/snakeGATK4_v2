rule GeneratePloidyLists:
    output:
        diploid = os.path.join(META_DIR, "diploids.list"),
        tetraploid = os.path.join(META_DIR, "tetraploids.list")
    run:
        diploids = [s for s, p in samples_ploidy.items() if str(p) == "2"]
        tetraploids = [s for s, p in samples_ploidy.items() if str(p) == "4"]

        with open(output.diploid, 'w') as out:
            out.write("\n".join(diploids) + "\n") if diploids else None

        with open(output.tetraploid, 'w') as out:
            out.write("\n".join(tetraploids) + "\n") if tetraploids else None



rule SplitVariant:
    input:
        final_path + "/gatk4/final_vcf/raw.vcf.gz"
    output:
        vcf=temp(final_path + "/gatk4/final_vcf/variant.vcf.gz"),
        index=temp(final_path + "/gatk4/final_vcf/variant.vcf.gz.tbi")
    benchmark:
        "benchmarks/SplitVariantAndInvariant/SplitVariant.txt"
    resources:
        mem_mb = 8000,
        time = "2-0"
    threads:
        30
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        r"""
        # also already filter out sites with 50% missing data, so that we have less sites to deal with
        bcftools filter --threads {threads} -i "MAC > 0 && F_MISSING <= 0.5" {input} -O z > {output.vcf}
        bcftools index --tbi {output.vcf}
        """


rule SplitInvariant:
    input:
        final_path + "/gatk4/final_vcf/raw.vcf.gz"
    output:
        invariant=temp(final_path + "/gatk4/final_vcf/invariant.vcf.gz"),
        invariant_index=temp(final_path + "/gatk4/final_vcf/invariant.vcf.gz.tbi")
    benchmark:
        "benchmarks/SplitVariantAndInvariant/SplitInvariant.txt"
    resources:
        mem_mb = 8000,
        time = "2-0"
    threads:
        30
    params:
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        r"""
        # also already filter out sites with 50% missing data, so that we have less sites to deal with
        bcftools filter --threads {threads} -i "MAC == 0 && F_MISSING <= 0.5" {input} -O z > {output.invariant}
        bcftools index --tbi {output.invariant}
        """


rule MarkFilterVariant:
    input:
        final_path + "/gatk4/final_vcf/variant.vcf.gz",
        final_path + "/gatk4/final_vcf/variant.vcf.gz.tbi"
    output:
        vcf=temp(final_path + "/gatk4/final_vcf/mark-filter_variant.vcf.gz"),
        index=temp(final_path + "/gatk4/final_vcf/mark-filter_variant.vcf.gz.tbi"),
        stats=final_path + "/gatk4/final_vcf/mark-filter_variant.stats.txt"
    benchmark:
        "benchmarks/SoftFilter/MarkFilter_variant.txt"
    threads:
        20
    resources:
        mem_mb = 16000,
        time = "4-0"
    params:
        qual = config["HaplotypeCaller"]["qual"],
        fisherstrand = config["HaplotypeCaller"]["fisherstrand"],
        quality_by_depth = config["HaplotypeCaller"]["quality_by_depth"],
        strand_odds_ratio = config["HaplotypeCaller"]["strand_odds_ratio"],
        RMSMappingQuality = config["HaplotypeCaller"]["RMSMappingQuality"],
        MappingQualityRankSumTest = config["HaplotypeCaller"]["MappingQualityRankSumTest"],
        ReadPosRankSum = config["HaplotypeCaller"]["ReadPosRankSum"],
        outputpath = final_path + "/gatk4/final_vcf/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        gatk --java-options "-Xmx12g -Xms12g" \
            VariantFiltration \
            --verbosity ERROR \
            -R {GENOME} \
            --variant {input[0]} \
            --filter-expression "QUAL < {params.qual}"                --filter-name "QUAL_quality" \
            --filter-expression "FS > {params.fisherstrand}"          --filter-name "FS_fisherstrand" \
            --filter-expression "QD < {params.quality_by_depth}"      --filter-name "QD_quality_by_depth" \
            --filter-expression "SOR > {params.strand_odds_ratio}"    --filter-name "SOR_strand_odds_ratio" \
            --filter-expression "RMSMappingQuality < {params.RMSMappingQuality}" --filter-name "RMSMappingQuality" \
            --filter-expression "MappingQualityRankSumTest < {params.MappingQualityRankSumTest}" --filter-name "MappingQualityRankSumTest" \
            --filter-expression "ReadPosRankSum < {params.ReadPosRankSum}" --filter-name "ReadPosRankSum" \
            -O {output.vcf}

        bcftools index {output.vcf}
        # bcftools index --tbi {output.vcf}

        bcftools stats --threads {threads} \
                    -s- --verbose {output.vcf} > {output.stats}


        """

