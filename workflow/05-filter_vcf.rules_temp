import pandas as pd
import os
configfile: "config.yaml"

samples = pd.read_csv(config["METAFILE"],sep='\t').set_index(["sample"], drop=False)
final_path = config["final_output"] 

sample=samples["sample"]

GENOME = config["GENOME"]

samples_ploidy = samples["ploidy"].to_dict()
ploidies = samples["ploidy"].unique().tolist()
print(ploidies)

# Depth thresholds per ploidy
ploidy_dp = {
    "2": {"min": config["GATK"]["min_depth"]["di"], "max": config["GATK"]["max_depth"]["di"]},
    "4": {"min": config["GATK"]["min_depth"]["tetra"], "max": config["GATK"]["max_depth"]["tetra"]}
}

# interval scattering parameters (override in config.yaml)
INTERVALS_DIR = config.get("intervals_dir", "intervals")
SCATTER_COUNT = int(config.get("scatter_count", 20))



rule end:
    input:
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.vcf.gz",
        final_path + "/gatk4/final_vcf/4_fold_degenerate_filtered.ld_pruned.stats.txt",
        final_path + "/gatk4/final_vcf/multiqc_report.html",
        final_path + "/gatk4/final_vcf/dp_distribution_numgeno.pdf",
        final_path + "/gatk4/final_vcf/dp_distribution_numsites.pdf"
        


    # Helper function for interval filenames
    def scattered_interval_name(i):
        """Return e.g. '0000-scattered.interval_list' for i=0."""
        return f"{i:04d}-scattered.interval_list"

    # Get intervals dir and scatter count from config
    INTERVALS_DIR = config["intervals_dir"]
    SCATTER_COUNT = config["scatter_count"]
    SCATTERED_INTERVAL_LISTS = [
        os.path.join(INTERVALS_DIR, scattered_interval_name(i))
        for i in range(SCATTER_COUNT)
    ]

    rule scatter_filtered_vcf:
        input:
            vcf = final_path + "/gatk4/final_vcf/raw.vcf.gz"
        output:
            scattered = temp(final_path + "/gatk4/final_vcf/scattered/scattered_{i}.vcf.gz"),
            scattered_tbi = temp(final_path + "/gatk4/final_vcf/scattered/scattered_{i}.vcf.gz.tbi")
        params:
            interval = lambda wildcards: os.path.join(INTERVALS_DIR, f"{int(wildcards.i):04d}-scattered.interval_list"),
            outdir = final_path + "/gatk4/final_vcf/scattered",
        threads: 4
        conda:
            "../env/gatk4_calling_env.yaml"
        shell:
            """
            mkdir -p {params.outdir}
            gatk SelectVariants -R {GENOME} -V {input.vcf} -L {params.interval} -O {output.scattered}
            bcftools index --tbi {output.scattered}
            """



rule SplitVariant:
    input:
        vcf = final_path + "/gatk4/final_vcf/scattered/scattered_{i}.vcf.gz"
    output:
        vcf=temp(final_path + "/gatk4/final_vcf/scattered/variant_{i}.vcf.gz"),
        index=temp(final_path + "/gatk4/final_vcf/scattered/variant_{i}.vcf.gz.tbi")
    benchmark:
        "benchmarks/SplitVariantAndInvariant/SplitVariant.{i}.txt"
    threads:
        4
    params:
        outputpath = final_path + "/gatk4/final_vcf/scattered/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        r"""
        # filter variant sites within this scatter (keep sites with MAC>0)
        bcftools filter --threads {threads} -i "MAC > 0 && F_MISSING <= 0.5" {input.vcf} -O z > {output.vcf}
        bcftools index --tbi {output.vcf}
        """


rule SplitInvariant:
    input:
        vcf = final_path + "/gatk4/final_vcf/scattered/scattered_{i}.vcf.gz"
    output:
        invariant=temp(final_path + "/gatk4/final_vcf/scattered/invariant_{i}.vcf.gz"),
        invariant_index=temp(final_path + "/gatk4/final_vcf/scattered/invariant_{i}.vcf.gz.tbi")
    benchmark:
        "benchmarks/SplitVariantAndInvariant/SplitInvariant.{i}.txt"
    threads:
        4
    params:
        outputpath = final_path + "/gatk4/final_vcf/scattered/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        r"""
        # filter invariant sites within this scatter (MAC == 0)
        bcftools filter --threads {threads} -i "MAC == 0 && F_MISSING <= 0.5" {input.vcf} -O z > {output.invariant}
        bcftools index --tbi {output.invariant}
        """



rule MarkFilterVariant:
    input:
        vcf = final_path + "/gatk4/final_vcf/scattered/variant_{i}.vcf.gz",
        vcf_tbi = final_path + "/gatk4/final_vcf/scattered/variant_{i}.vcf.gz.tbi"
    output:
        vcf=temp(final_path + "/gatk4/final_vcf/scattered/mark-filter_variant_{i}.vcf.gz"),
        index=temp(final_path + "/gatk4/final_vcf/scattered/mark-filter_variant_{i}.vcf.gz.tbi")
    benchmark:
        "benchmarks/SoftFilter/MarkFilter_variant.{i}.txt"
    threads:
        4
    params:
        qual = config["HaplotypeCaller"]["qual"],
        fisherstrand = config["HaplotypeCaller"]["fisherstrand"],
        quality_by_depth = config["HaplotypeCaller"]["quality_by_depth"],
        strand_odds_ratio = config["HaplotypeCaller"]["strand_odds_ratio"],
        RMSMappingQuality = config["HaplotypeCaller"]["RMSMappingQuality"],
        MappingQualityRankSumTest = config["HaplotypeCaller"]["MappingQualityRankSumTest"],
        ReadPosRankSum = config["HaplotypeCaller"]["ReadPosRankSum"],
        outputpath = final_path + "/gatk4/final_vcf/scattered/"
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
        gatk --java-options "-Xmx12g -Xms12g" \
            VariantFiltration \
            --verbosity ERROR \
            -R {GENOME} \
            --variant {input.vcf} \
            --filter-expression "QUAL < {params.qual}"                --filter-name "QUAL_quality" \
            --filter-expression "FS > {params.fisherstrand}"          --filter-name "FS_fisherstrand" \
            --filter-expression "QD < {params.quality_by_depth}"      --filter-name "QD_quality_by_depth" \
            --filter-expression "SOR > {params.strand_odds_ratio}"    --filter-name "SOR_strand_odds_ratio" \
            --filter-expression "RMSMappingQuality < {params.RMSMappingQuality}" --filter-name "RMSMappingQuality" \
            --filter-expression "MappingQualityRankSumTest < {params.MappingQualityRankSumTest}" --filter-name "MappingQualityRankSumTest" \
            --filter-expression "ReadPosRankSum < {params.ReadPosRankSum}" --filter-name "ReadPosRankSum" \
            -O {output.vcf}

        bcftools index --tbi {output.vcf}
        """

