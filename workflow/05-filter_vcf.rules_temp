            --filter-expression "MappingQualityRankSumTest < {params.MappingQualityRankSumTest}" --filter-name "MappingQualityRankSumTest" \
            --filter-expression "ReadPosRankSum < {params.ReadPosRankSum}" --filter-name "ReadPosRankSum" \
            -O {output.vcf}

        bcftools index --tbi{output.vcf}
        """

rule ApplyFilter_variants:
    input:
        vcf = final_path + "/gatk4/final_vcf/scattered/mark-filter_variant_{i}.vcf.gz",
        vcf_tbi = final_path + "/gatk4/final_vcf/scattered/mark-filter_variant_{i}.vcf.gz.tbi"
    output:
        temp(final_path + "/gatk4/final_vcf/scattered/filtered_variant_{i}.vcf.gz"),
        temp(final_path + "/gatk4/final_vcf/scattered/filtered_variant_{i}.vcf.gz.tbi")
    benchmark:
        "benchmarks/ApplyFilter/ApplyFilter_variants.{i}.txt"
    threads:
        4
    params:
        outputpath = final_path + "/gatk4/final_vcf/scattered/",
        high_heterozygosity = config["HaplotypeCaller"]["high_heterozygosity"]
    conda:
        "../env/gatk4_calling_env.yaml"
    shell:
        """
            bcftools filter --threads {threads} -O u --exclude 'FILTER != "PASS"' {input.vcf} |\
            bcftools view --threads {threads} -O z > {output[0]}

        bcftools index {output[0]}
        bcftools index --tbi {output[0]}
        """

